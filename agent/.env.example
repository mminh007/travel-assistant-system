# -- 9Router API Keys --
NINE_ROUTER_API_KEY=dummy-key
# -- Redis Configuration --
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

#  -- Qdrant Configuration --
QDRANT_COLLECTION_NAME=long_term_memory
QDRANT_SERVER_HOST=localhost
QDRANT_SERVER_PORT=6333

# -- RabbitMQ Configuration--
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_NAME=fact_extraction_queue

# LOGGING ARCHITECTURE CONFIGURATION
LOGS_DIR=./logs
LOGS_MAX_BYTES=10485760  # 10MB (10 * 1024 * 1024)
LOGS_BACKUP_COUNT=5

# TAVILY AGENT CONFIGURATION
TAVILY_MAX_TOKEN_BUDGET=2000

# 9ROUTER CONFIGURATION
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_TIER1_FAST_MODEL=gpt-4o-mini
NINE_ROUTER_TIER2_BALANCED_MODEL=gpt-4o
NINE_ROUTER_TIER3_REASONING_MODEL=o1-mini

# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================
# "nine_router" (default) | "vllm" (self-hosted on vast.ai)
LLM_PROVIDER=vllm

# ==============================================================================
# vLLM Self-Hosted Configuration (vast.ai)
# ==============================================================================
VLLM_BASE_URL=http://<host>:<port>/v1
VLLM_EMBEDDING_BASE_URL=http://<host>:<port>/v1
# Prometheus scrape targets — set to host:port (no scheme) of vLLM /metrics endpoint
# Local dev: host.docker.internal:8000 | vast.ai: <hash>.vast.ai:<port>
VLLM_METRICS_HOST=<host>:<port>
VLLM_EMBEDDING_METRICS_HOST=<host>:<port>
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
VLLM_API_KEY=EMPTY
VLLM_MAX_COMPLETION_TOKENS=1024
VLLM_MAX_CONTEXT_TOKENS=4096

# ==============================================================================
# MCP Security Settings
# ==============================================================================
MCP_JWT_SECRET=default_mcp_jwt_secret_key_change_me_in_prod
SECURITY_AI_RECEIPT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPRIVATE_KEY\n-----END PRIVATE KEY-----"

SECURITY_AI_RECEIPT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPUBLIC_KEY\n-----END PUBLIC KEY-----"
