@{
    ViewData["Title"] = "Payment Cancelled";
}

<div class="container mt-5 mb-5 text-center">
    <div class="py-5">
        <i class="bi bi-x-circle-fill text-danger mb-3" style="font-size: 5rem;"></i>
        <h1 class="display-4 fw-bold">Payment Cancelled</h1>
        <p class="lead text-muted mt-3">Your payment was cancelled and no charges were made.</p>
        
        <div class="mt-5">
            <a href="javascript:history.back()" class="btn btn-outline-primary btn-lg me-3">Try Again</a>
            <a href="/" class="btn btn-primary btn-lg">Return to Home</a>
        </div>
    </div>
</div>
