@model Booking.Web.Models.Domain.RoomType

@{
    ViewData["Title"] = "Confirm your booking";
    var checkIn = ViewData["CheckIn"]?.ToString();
    var checkOut = ViewData["CheckOut"]?.ToString();
    var nights = ViewData["Nights"] != null ? (int)ViewData["Nights"] : 1;
    var totalPrice = ViewData["TotalPrice"] != null ? (decimal)ViewData["TotalPrice"] : Model.PricePerNight;
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <img src="@Model.Hotel.ThumbnailUrl" class="card-img-top object-fit-cover" alt="@Model.Hotel.Name" style="height: 200px;">
                <div class="card-body">
                    <h5 class="card-title">@Model.Hotel.Name</h5>
                    <p class="card-text text-muted small"><i class="bi bi-geo-alt-fill"></i> @Model.Hotel.Address</p>
                    <hr>
                    <div class="mb-3">
                        <div class="fw-bold">@Model.Name</div>
                        <div class="small text-muted">@Model.Description</div>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Check-in</span>
                        <span class="fw-bold">@checkIn</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Check-out</span>
                        <span class="fw-bold">@checkOut</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Length of stay</span>
                        <span class="fw-bold">@nights night(s)</span>
                    </div>
                    <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold">Total Price</span>
                        <span class="fs-4 fw-bold text-primary">VND @totalPrice.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <h2 class="mb-4">Review and Confirm Your Booking</h2>
            
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h4 class="card-title">Guest Details</h4>
                    <p class="text-muted">Please ensure your details are correct before proceeding to payment.</p>
                    
                    <!-- We could put a form here to collect guest name/email if not logged in or if they want to book for someone else -->
                    <form id="guest-details-form">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="guestName" class="form-label">Guest Name</label>
                                <input type="text" class="form-control" id="guestName" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="guestEmail" class="form-label">Email Address</label>
                                <input type="email" class="form-control" id="guestEmail" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="phoneNumber" class="form-label">Phone Number</label>
                            <input type="tel" class="form-control" id="phoneNumber" required>
                        </div>
                        <div class="mb-3">
                            <label for="specialRequests" class="form-label">Special Requests (Optional)</label>
                            <textarea class="form-control" id="specialRequests" rows="2"></textarea>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body text-center py-5">
                    <i class="bi bi-shield-lock text-success mb-3" style="font-size: 3rem;"></i>
                    <h4 class="card-title">Secure Payment</h4>
                    <p class="card-text text-muted">You will be redirected to our secure payment partner (Stripe) to complete your transaction.</p>
                    
                    <button class="btn btn-primary btn-lg px-5 py-3 fw-bold mt-3" id="checkout-btn" data-room-id="@Model.Id" data-check-in="@checkIn" data-check-out="@checkOut" data-guests="2">
                        Proceed to Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="paymentModalLabel">Complete Your Payment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="checkout">
          <!-- Stripe Embedded Checkout will be mounted here -->
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripePublishableKey = '@ViewData["StripePublishableKey"]';
    </script>
    <script src="~/js/modules/BookingConfirmation.js" asp-append-version="true" defer></script>
}
