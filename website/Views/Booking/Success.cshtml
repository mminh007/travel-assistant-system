@{
    ViewData["Title"] = "Booking Successful";
}

<div class="container mt-5 mb-5 text-center">
    <div class="py-5">
        <i class="bi bi-check-circle-fill text-success mb-3" style="font-size: 5rem;"></i>
        <h1 class="display-4 fw-bold">Payment Successful!</h1>
        <p class="lead text-muted mt-3">Your booking has been confirmed. Thank you for choosing us.</p>
        @if (ViewData["SessionId"] != null)
        {
            <p class="small text-muted">Session ID: @ViewData["SessionId"]</p>
        }
        <div class="mt-5">
            <a href="/" class="btn btn-primary btn-lg">Return to Home</a>
        </div>
    </div>
</div>
