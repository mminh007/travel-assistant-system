@model IEnumerable<Booking.Web.Models.Domain.BookingRecord>
@{
    ViewData["Title"] = "Booking History";
    var paidBookings = Model.Where(b => b.Status == "Success").ToList();
    var pendingBookings = Model.Where(b => b.Status == "Pending").ToList();
}

<div class="container py-5" id="historyBookingContainer">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="display-6 fw-bold text-primary">Your Bookings</h2>
            <p class="text-muted">Manage your upcoming and past reservations.</p>
        </div>
    </div>

    <ul class="nav nav-pills nav-fill mb-4 custom-pills" id="bookingTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill premium-pill" id="paid-tab" data-bs-toggle="tab" data-bs-target="#paid" type="button" role="tab" aria-controls="paid" aria-selected="true">
                <i class="bi bi-check-circle-fill me-2"></i>Paid Bookings (@paidBookings.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill premium-pill" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab" aria-controls="pending" aria-selected="false">
                <i class="bi bi-clock-fill me-2"></i>Pending Bookings (@pendingBookings.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="bookingTabContent">
        <!-- PAID BOOKINGS TAB -->
        <div class="tab-pane fade show active" id="paid" role="tabpanel" aria-labelledby="paid-tab">
            <div class="row g-4">
                @if (!paidBookings.Any())
                {
                    <div class="col-12 text-center py-5 bg-light rounded-4 shadow-sm border premium-empty-state">
                        <i class="bi bi-journal-x text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                        <h5 class="text-muted">No paid bookings found.</h5>
                    </div>
                }
                else
                {
                    foreach (var booking in paidBookings)
                    {
                        var hoursSinceCreation = (DateTime.UtcNow - booking.CreatedAt).TotalHours;
                        var canCancel = hoursSinceCreation <= 24;

                        <div class="col-md-6 col-lg-4 booking-card-wrapper" id="booking-@booking.Id">
                            <div class="card h-100 shadow-sm border-0 premium-card">
                                <div class="card-body">
                                    <h5 class="card-title fw-bold text-dark">@booking.RoomType.Hotel.Name</h5>
                                    <h6 class="card-subtitle mb-3 text-muted">@booking.RoomType.Name</h6>
                                    
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span class="text-muted"><i class="bi bi-box-arrow-in-right me-1"></i>Check-in</span>
                                        <span class="fw-medium">@booking.CheckInDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span class="text-muted"><i class="bi bi-box-arrow-right me-1"></i>Check-out</span>
                                        <span class="fw-medium">@booking.CheckOutDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3 small">
                                        <span class="text-muted"><i class="bi bi-moon me-1"></i>Duration</span>
                                        <span class="fw-medium">@booking.TotalNights Nights</span>
                                    </div>
                                    
                                    <div class="bg-light p-2 rounded-3 text-center mb-3">
                                        <span class="d-block text-muted small">Total Price</span>
                                        <span class="fw-bold fs-5 text-primary">@booking.TotalPrice.ToString("C")</span>
                                    </div>
                                    
                                    <div class="d-grid gap-2 mt-auto">
                                        @if (canCancel)
                                        {
                                            <button class="btn btn-outline-danger btn-cancel premium-btn" data-id="@booking.Id">
                                                Cancel Booking
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary premium-btn disabled" disabled>
                                                Cancel Booking
                                            </button>
                                            <small class="text-danger text-center mt-1" style="font-size: 0.75rem;">Cannot cancel after 24 hours.</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- PENDING BOOKINGS TAB -->
        <div class="tab-pane fade" id="pending" role="tabpanel" aria-labelledby="pending-tab">
            <div class="row g-4">
                @if (!pendingBookings.Any())
                {
                    <div class="col-12 text-center py-5 bg-light rounded-4 shadow-sm border premium-empty-state">
                        <i class="bi bi-clock-history text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                        <h5 class="text-muted">No pending bookings found.</h5>
                    </div>
                }
                else
                {
                    foreach (var booking in pendingBookings)
                    {
                        <div class="col-md-6 col-lg-4 booking-card-wrapper" id="booking-@booking.Id">
                            <div class="card h-100 shadow-sm border-0 premium-card pending-card">
                                <div class="card-body">
                                    <span class="badge bg-warning text-dark mb-2 position-absolute top-0 end-0 m-3 rounded-pill">Pending</span>
                                    
                                    <h5 class="card-title fw-bold text-dark pe-5">@booking.RoomType.Hotel.Name</h5>
                                    <h6 class="card-subtitle mb-3 text-muted">@booking.RoomType.Name</h6>
                                    
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span class="text-muted"><i class="bi bi-box-arrow-in-right me-1"></i>Check-in</span>
                                        <span class="fw-medium">@booking.CheckInDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span class="text-muted"><i class="bi bi-box-arrow-right me-1"></i>Check-out</span>
                                        <span class="fw-medium">@booking.CheckOutDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    
                                    <div class="bg-light p-2 rounded-3 text-center mb-3 mt-3 border border-warning border-opacity-50">
                                        <span class="d-block text-muted small">Total Price</span>
                                        <span class="fw-bold fs-5 text-warning-emphasis">@booking.TotalPrice.ToString("C")</span>
                                    </div>
                                    
                                    <div class="d-flex gap-2 mt-auto">
                                        <button class="btn btn-primary flex-grow-1 btn-pay premium-btn" 
                                            data-roomtype-id="@booking.RoomTypeId" 
                                            data-checkin="@booking.CheckInDate.ToString("yyyy-MM-dd")" 
                                            data-checkout="@booking.CheckOutDate.ToString("yyyy-MM-dd")"
                                            data-guests="@booking.GuestCount"
                                            data-name="@booking.GuestName"
                                            data-email="@booking.GuestEmail"
                                            data-phone="@booking.PhoneNumber"
                                            data-requests="@booking.SpecialRequests">
                                            Pay Now
                                        </button>
                                        <button class="btn btn-outline-danger flex-grow-0 btn-cancel premium-btn" data-id="@booking.Id" title="Cancel">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script src="~/js/modules/BookingHistory.js" asp-append-version="true"></script>
}
