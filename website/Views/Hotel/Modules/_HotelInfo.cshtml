@model Booking.Web.Models.Domain.Hotel
@using System.Text.Json

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-secondary text-uppercase">@(Model.RoomTypes.FirstOrDefault()?.Type ?? "Hotel")</span>
            <div>
                @for (int i = 0; i < Model.StarRating; i++)
                {
                    <i class="bi bi-star-fill text-warning"></i>
                }
            </div>
        </div>
        <h1 class="h2 mb-1 fw-bold">@Model.Name</h1>
        <p class="text-muted mb-0"><i class="bi bi-geo-alt-fill text-primary"></i> @Model.Address, @Model.City</p>
    </div>
    <div class="text-end">
        <button class="btn btn-outline-primary"><i class="bi bi-heart"></i> Save</button>
        <button class="btn btn-outline-secondary"><i class="bi bi-share"></i> Share</button>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-8">
        <p>@Model.Description</p>
        
        <h4 class="mt-4 mb-3">Most popular facilities</h4>
        <div class="d-flex flex-wrap gap-3 mb-4">
            @{
                var allAmenities = new HashSet<string>();
                foreach (var rt in Model.RoomTypes)
                {
                    try
                    {
                        var amenities = JsonSerializer.Deserialize<List<string>>(rt.Amenities);
                        if (amenities != null)
                        {
                            foreach (var a in amenities)
                            {
                                allAmenities.Add(a);
                            }
                        }
                    }
                    catch { /* ignore */ }
                }

                foreach (var amenity in allAmenities.Take(10))
                {
                    <div class="d-flex align-items-center gap-2 text-success">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@amenity</span>
                    </div>
                }
            }
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-light border-0">
            <div class="card-body">
                <h5 class="card-title mb-3">Property highlights</h5>
                <p class="card-text small"><i class="bi bi-pin-map text-primary"></i> Top location: Highly rated by recent guests (9.5)</p>
                <h6 class="mt-3">Breakfast info</h6>
                <p class="card-text small">Continental, Italian, Full English/Irish, Vegetarian, Vegan, Halal, Gluten-free, Asian, American, Buffet</p>
            </div>
        </div>
    </div>
</div>
