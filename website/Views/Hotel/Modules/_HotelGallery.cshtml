@model Booking.Web.Models.Domain.Hotel
@{
    // In a real scenario, you'd have an Image model linked to Hotel.
    // We are simulating a gallery with the ThumbnailUrl and some placeholders.
    var images = new List<string> { Model.ThumbnailUrl };
    // Add some placeholders for the gallery
    images.Add("https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80");
    images.Add("https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80");
    images.Add("https://images.unsplash.com/photo-1522771731535-6aa29c42a225?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80");
}

<div class="row g-2 mb-4">
    <div class="col-md-8">
        @if (images.Count > 0)
        {
            <img src="@images[0]" class="img-fluid rounded w-100 h-100 object-fit-cover" alt="@Model.Name" style="max-height: 500px;">
        }
    </div>
    <div class="col-md-4 d-flex flex-column gap-2">
        @for (int i = 1; i < Math.Min(3, images.Count); i++)
        {
            <img src="@images[i]" class="img-fluid rounded w-100 object-fit-cover" alt="@Model.Name" style="height: calc(50% - 0.25rem);">
        }
        @if (images.Count > 3)
        {
            <div class="position-relative w-100" style="height: calc(50% - 0.25rem);">
                <img src="@images[3]" class="img-fluid rounded w-100 h-100 object-fit-cover" alt="@Model.Name">
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center bg-dark bg-opacity-50 text-white rounded cursor-pointer">
                    <span class="fs-5 fw-bold">+@(images.Count - 3) photos</span>
                </div>
            </div>
        }
    </div>
</div>
