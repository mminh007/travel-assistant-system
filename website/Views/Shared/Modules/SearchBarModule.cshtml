<form action="/Hotel/Search" method="GET" id="searchForm" class="bg-warning p-2 rounded d-flex flex-wrap gap-2 shadow-sm align-items-center" style="margin-top: -25px; position: relative; z-index: 10;">
    <div class="flex-grow-1 position-relative">
        <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"><i class="bi bi-geo-alt-fill"></i></span>
        <input type="text" class="form-control form-control-lg border-0 ps-5" placeholder="Where are you going?" name="destination" value="@ViewData["Destination"]">
    </div>
    <div class="flex-grow-1 position-relative">
        <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"><i class="bi bi-calendar-date"></i></span>
        <input type="text" id="dateRangePicker" class="form-control form-control-lg border-0 ps-5" placeholder="Check-in - Check-out" name="dates" value="@ViewData["Dates"]">
    </div>
    <div class="flex-grow-1 position-relative dropdown" id="guestDropdownWrapper">
        <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"><i class="bi bi-person-fill"></i></span>
        <input type="text" id="guestInput" class="form-control form-control-lg border-0 ps-5" placeholder="2 adults · 0 children · 1 room" name="guests" value="@ViewData["Guests"]" readonly data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" style="cursor: pointer; background-color: #fff;">
        
        <div class="dropdown-menu p-3 shadow border-0 mt-2" style="width: 320px; border-radius: 8px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-bold">Adults</span>
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-outline-primary rounded-circle shadow-none d-flex align-items-center justify-content-center guest-btn" data-type="adults" data-action="minus" style="width: 36px; height: 36px;" disabled><i class="bi bi-dash"></i></button>
                    <span id="adultCount" class="fw-semibold" style="width: 15px; text-align: center;">2</span>
                    <button type="button" class="btn btn-outline-primary rounded-circle shadow-none d-flex align-items-center justify-content-center guest-btn" data-type="adults" data-action="plus" style="width: 36px; height: 36px;"><i class="bi bi-plus"></i></button>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-bold">Children</span>
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-outline-primary rounded-circle shadow-none d-flex align-items-center justify-content-center guest-btn" data-type="children" data-action="minus" style="width: 36px; height: 36px;" disabled><i class="bi bi-dash"></i></button>
                    <span id="childCount" class="fw-semibold" style="width: 15px; text-align: center;">0</span>
                    <button type="button" class="btn btn-outline-primary rounded-circle shadow-none d-flex align-items-center justify-content-center guest-btn" data-type="children" data-action="plus" style="width: 36px; height: 36px;"><i class="bi bi-plus"></i></button>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold">Rooms</span>
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-outline-primary rounded-circle shadow-none d-flex align-items-center justify-content-center guest-btn" data-type="rooms" data-action="minus" style="width: 36px; height: 36px;" disabled><i class="bi bi-dash"></i></button>
                    <span id="roomCount" class="fw-semibold" style="width: 15px; text-align: center;">1</span>
                    <button type="button" class="btn btn-outline-primary rounded-circle shadow-none d-flex align-items-center justify-content-center guest-btn" data-type="rooms" data-action="plus" style="width: 36px; height: 36px;"><i class="bi bi-plus"></i></button>
                </div>
            </div>
            <div class="mt-3 text-end">
                <button type="button" class="btn btn-outline-primary btn-sm px-4 fw-bold" id="btnDoneGuest">Done</button>
            </div>
        </div>
    </div>
    <div>
        <button type="submit" id="btnSearch" class="btn btn-primary btn-lg fw-bold px-4">Search</button>
    </div>
</form>

<script src="~/js/modules/SearchBarModule.js" asp-append-version="true" defer></script>
