@model Booking.Web.Models.Domain.Hotel

<div class="card mb-3 shadow-sm border-0 position-relative">
    <div class="row g-0">
        <div class="col-md-4 position-relative">
            <img src="@Model.ThumbnailUrl" class="img-fluid rounded-start h-100 object-fit-cover" alt="@Model.Name">
            <div class="position-absolute top-0 end-0 p-2">
                <button class="btn btn-light btn-sm rounded-circle shadow-sm"><i class="bi bi-heart"></i></button>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card-body d-flex flex-column h-100">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-primary mb-1">@Model.Name</h5>
                        <div class="mb-2">
                            @for(int i = 0; i < Model.StarRating; i++)
                            {
                                <i class="bi bi-star-fill text-warning small"></i>
                            }
                            <span class="ms-2 small text-primary"><i class="bi bi-hand-thumbs-up-fill"></i></span>
                        </div>
                        <p class="card-text small mb-1">
                            <a href="#" class="text-primary text-decoration-underline">@Model.Address, @Model.City</a>
                            <span class="text-muted ms-2">2.5 km from center</span>
                        </p>
                        <span class="badge bg-success mb-2">Sustainable Travel Level 2</span>
                        <p class="card-text small border-start border-3 border-secondary ps-2 mb-1">@Model.Description</p>
                    </div>
                    <div class="text-end">
                        <div class="d-flex align-items-center justify-content-end mb-2">
                            <div class="me-2 text-end">
                                <div class="fw-bold">Excellent</div>
                                <div class="text-muted small">1,245 reviews</div>
                            </div>
                            <div class="bg-primary text-white fw-bold rounded p-2 fs-5">8.9</div>
                        </div>
                    </div>
                </div>

                <div class="mt-auto row">
                    <div class="col-8">
                        <div class="fw-bold small">Deluxe Double Room</div>
                        <div class="text-muted small">1 extra-large double bed</div>
                        <div class="text-success small fw-bold mt-1"><i class="bi bi-check text-success"></i> Free cancellation</div>
                        <div class="text-success small"><i class="bi bi-check text-success"></i> No prepayment needed <span class="text-muted">– pay at the property</span></div>
                        <div class="text-danger small mt-1 fw-bold">Only 2 rooms left at this price on our site</div>
                    </div>
                    <div class="col-4 text-end d-flex flex-column justify-content-end">
                        <div class="text-muted small">2 nights, 2 adults</div>
                        <div class="text-decoration-line-through text-danger small">VND 3,500,000</div>
                        <div class="fs-4 fw-bold">VND 2,800,000</div>
                        <div class="text-muted small mb-2">+VND 250,000 taxes and charges</div>
                        <a href="#" class="btn btn-primary fw-bold">See availability <i class="bi bi-chevron-right small"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
