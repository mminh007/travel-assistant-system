@model IEnumerable<Booking.Web.Models.Domain.Hotel>

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Nha Trang: @Model.Count() properties found</h3>
        <div class="dropdown">
            <button id="sortByBtn" class="btn btn-outline-secondary dropdown-toggle rounded-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Sort by: <span id="sortByLabel">Price (lowest first)</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" id="sortByMenu">
                <li><a class="dropdown-item active" href="#" data-sort="price_asc">Price (lowest first)</a></li>
                <li><a class="dropdown-item" href="#" data-sort="price_desc">Price (highest first)</a></li>
                <li><a class="dropdown-item" href="#" data-sort="star_desc">Star rating (highest first)</a></li>
                <li><a class="dropdown-item" href="#" data-sort="star_asc">Star rating (lowest first)</a></li>
                <li><a class="dropdown-item" href="#" data-sort="name_asc">Name (A–Z)</a></li>
            </ul>
        </div>
    </div>

    <div id="hotelListContainer">
    @foreach(var hotel in Model)
    {
        await Html.RenderPartialAsync("Modules/HotelCardModule", hotel);
    }
    </div>

    <nav aria-label="Page navigation" class="mt-4" id="paginationContainer">
        <ul class="pagination justify-content-center">
            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">Next</a></li>
        </ul>
    </nav>
</div>
